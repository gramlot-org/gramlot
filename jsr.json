{
  "name": "@gramlot/gramlot",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "exports": {
    ".": "./js/src/index.js",
    "./server": "./js/src/adapters/index.js",
    "./runtime": "./js/dist/gramlot.js",
    "./page": "./js/src/adapters/page.js",
    "./host": "./js/src/adapters/host.js"
  },
  "imports": {
    "@genrojs/bag": "jsr:@genro/bag@^0.10.1",
    "@genrojs/builders": "jsr:@genro/builders@^0.4.1",
    "@genrojs/tytx": "jsr:@genro/tytx@^0.16.1",
    "@gramlot/gramlot/page": "./js/src/adapters/page.js"
  },
  "publish": {
    "include": [
      "js/src/**",
      "js/dist/**",
      "js/package.json",
      "themes/**",
      "examples/html_svg/**",
      "assets/branding/gramlot-logo.svg",
      "assets/branding/gramlot-logo-dark.svg",
      "assets/branding/gramlot-mark.png",
      "assets/branding/gramlot-mark-dark.png",
      "assets/branding/svg/**",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "exclude": [
      "!js/dist",
      "!js/dist/**"
    ]
  },
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "jsr:@genro/bag",
      "jsr:@genro/builders",
      "jsr:@genro/tytx",
      "npm:@genrojs/*",
      "npm:@genrojs/bag",
      "npm:@genrojs/builders",
      "npm:@genrojs/tytx"
    ]
  }
}
