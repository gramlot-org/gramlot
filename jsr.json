{
  "name": "@genro/gramlot",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "exports": {
    ".": "./js/src/index.js",
    "./server": "./js/src/adapters/index.js",
    "./runtime": "./js/dist/gramlot.js",
    "./page": "./js/src/adapters/page.js",
    "./host": "./js/src/adapters/host.js"
  },
  "imports": {
    "@jsr/genro__bag": "jsr:@genro/bag@^0.5.3",
    "@jsr/genro__builders": "jsr:@genro/builders@^0.1.5",
    "@jsr/genro__tytx": "jsr:@genro/tytx@^0.15.1"
  },
  "publish": {
    "include": [
      "js/src/**",
      "js/dist/**",
      "js/package.json",
      "themes/**",
      "examples/html_svg/**",
      "assets/branding/**",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "exclude": [
      "!js/dist",
      "!js/dist/**"
    ]
  },
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "npm:@jsr/genro__*"
    ]
  }
}
