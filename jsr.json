{
  "name": "@gramlot/gramlot",
  "version": "0.3.4",
  "license": "Apache-2.0",
  "exports": {
    ".": "./js/src/index.js",
    "./server": "./js/src/server/index.js",
    "./runtime": "./js/dist/gramlot.js",
    "./page": "./js/src/server/page.js",
    "./gramlot-server": "./js/src/server/gramlot-server.js",
    "./tools/inspector": "./js/tools/gramlot-tools-inspector.js",
    "./index-page-runtime": "./js/src/index-page-runtime.js",
    "./tools/inspector-agent": "./js/tools/inspector-agent.js",
    "./components": "./js/src/components/index.js",
    "./components/inputs": "./js/src/components/inputs.js",
    "./components/layout": "./js/src/components/layout.js"
  },
  "imports": {
    "@genrojs/bag": "jsr:@genro/bag@^0.11.0",
    "@genrojs/builders": "jsr:@genro/builders@^0.6.0",
    "@genrojs/tytx": "jsr:@genro/tytx@^0.16.2",
    "@gramlot/gramlot/page": "./js/src/server/page.js",
    "@gramlot/gramlot": "./js/src/index.js"
  },
  "publish": {
    "include": [
      "js/src/**",
      "js/dist/**",
      "js/package.json",
      "themes/**",
      "assets/branding/gramlot-logo.svg",
      "assets/branding/gramlot-logo-dark.svg",
      "assets/branding/gramlot-mark.png",
      "assets/branding/gramlot-mark-dark.png",
      "assets/branding/svg/**",
      "README.md",
      "LICENSE",
      "NOTICE",
      "js/tools/**",
      "assets/branding/app-icon.png"
    ],
    "exclude": [
      "!js/dist",
      "!js/dist/**",
      "!js/tools",
      "!js/tools/**"
    ]
  },
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": [
      "jsr:@genro/*",
      "jsr:@genro/bag",
      "jsr:@genro/builders",
      "jsr:@genro/tytx",
      "npm:@genrojs/*",
      "npm:@genrojs/bag",
      "npm:@genrojs/builders",
      "npm:@genrojs/tytx"
    ]
  }
}
