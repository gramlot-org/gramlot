{
  "name": "@gramlot/gramlot",
  "version": "0.3.8",
  "description": "Declarative HTML/SVG interfaces with live data binding, authored in JavaScript or Python.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramlot-org/gramlot.git",
    "directory": "js"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/binding-contracts/gramlot-quiet-write.test.mjs tests/upstream-regressions/builder-symbolic-attribute.test.mjs",
    "build": "node scripts/build-runtime.mjs",
    "test:server": "node --test tests/gramlot-server.test.js",
    "prepack": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@genrojs/bag": ">=0.11.0",
    "@genrojs/builders": ">=0.7.0",
    "@genrojs/tytx": ">=0.16.3",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "esbuild": "0.28.2",
    "jsdom": "27.0.1"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server/index.js",
    "./runtime": "./dist/gramlot.js",
    "./page": "./src/server/page.js",
    "./gramlot-server": "./src/server/gramlot-server.js",
    "./themes/*": "./themes/*",
    "./assets/branding/*": "./assets/branding/*",
    "./tools/inspector": "./tools/gramlot-tools-inspector.js",
    "./index-page-runtime": "./src/index-page-runtime.js",
    "./tools/inspector-agent": "./tools/inspector-agent.js",
    "./components": "./src/components/index.js",
    "./components/inputs": "./src/components/inputs.js",
    "./components/layout": "./src/components/layout.js",
    "./components/tree": "./src/components/tree.js"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "src",
    "dist",
    "themes",
    "assets",
    "tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
