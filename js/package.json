{
  "name": "@gramlot/gramlot",
  "version": "0.2.1",
  "description": "Declarative HTML/SVG interfaces with live data binding, authored in JavaScript or Python.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gramlot-org/gramlot.git",
    "directory": "js"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js tests/binding-contracts/gramlot-quiet-write.test.mjs tests/upstream-regressions/builder-symbolic-attribute.test.mjs",
    "build": "node scripts/build-runtime.mjs",
    "test:host": "node --test tests/host.test.js",
    "prepack": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@genrojs/bag": ">=0.10.1",
    "@genrojs/builders": ">=0.4.1",
    "@genrojs/tytx": ">=0.16.1"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "esbuild": "0.28.2",
    "jsdom": "27.0.1"
  },
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/adapters/index.js",
    "./runtime": "./dist/gramlot.js",
    "./page": "./src/adapters/page.js",
    "./host": "./src/adapters/host.js",
    "./themes/*": "./themes/*",
    "./assets/branding/*": "./assets/branding/*"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "src",
    "dist",
    "themes",
    "assets"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
