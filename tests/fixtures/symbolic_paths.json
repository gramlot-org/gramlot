    {"node": "anchor.a1.aleaf", "path": "=#ANCHOR.sel?label", "expect": "anc.sel?label"},
    {"node": "anchor.a1.aleaf", "path": ".#parent.y", "expect": "anc.y"},
    {"node": "page.form.rec.field", "path": "#pg.n", "expect": "pg.n"},
