    {"label": "page", "attrs": {"datapath": "pg", "nodeId": "pg"}, "children": [
      {"label": "form", "attrs": {"datapath": ".f1", "formId": "outer"}, "children": [
        {"label": "rec", "attrs": {"datapath": ".record"}, "children": [{"label": "field"}]},
        {"label": "inner", "attrs": {"datapath": ".sub", "formId": "inner"}, "children": [{"label": "leaf"}]}
      ]},
      {"label": "ws3", "attrs": {"_workspace": true}, "children": [{"label": "w3leaf"}]}
    ]},
    {"label": "anchor", "attrs": {"datapath": "anc", "_anchor": true}, "children": [
      {"label": "a1", "attrs": {"datapath": ".x"}, "children": [{"label": "aleaf"}]}
    ]},
    {"label": "ws1", "attrs": {"_workspace": "named"}, "children": [{"label": "wleaf"}]},
    {"label": "ws2", "attrs": {"_workspace": true, "nodeId": "wsid"}, "children": [{"label": "w2leaf"}]},
    {"label": "ws4", "attrs": {"datapath": "ws4data", "_workspace": true, "_workspace_path": ".private"}, "children": [{"label": "w4leaf"}]},
    {"label": "box", "attrs": {"nodeId": "panel", "datapath": "boxdata"}, "children": [
      {"label": "region", "attrs": {"childname": "top", "datapath": ".topdata"}, "children": [
        {"label": "named", "attrs": {"childname": "inner", "datapath": ".innerdata"}, "children": [
          {"label": "deep", "attrs": {"childname": "hidden", "datapath": ".hiddendata"}}
        ]},
        {"label": "bleaf"}
      ]},
      {"label": "unnamed", "children": [
        {"label": "found", "attrs": {"childname": "nested", "datapath": ".nesteddata"}}
      ]}
    ]},
    {"label": "aliases", "attrs": {"datapath": "cfg", "_aliasDatapaths": {"CHART": "gnr.chart", "LOCAL": ".local", "panel": "shadow"}}},
    {"label": "grid", "attrs": {"datapath": "gr", "storepath": ".rows", "rowMode": "values"}, "children": [{"label": "cell"}]},
    {"label": "agrid", "attrs": {"storepath": "arows", "rowMode": "attributes"}, "children": [{"label": "acell"}]},
    {"label": "nogrid", "attrs": {"storepath": "x"}, "children": [{"label": "ncell"}]}
  ],
  "cases": [
    {"node": "page.form.rec.field", "path": "#FORM.n", "expect": "pg.f1.n"},
    {"node": "page.form.rec.field", "path": "^#FORM.n?caption", "expect": "pg.f1.n?caption"},
    {"node": "page.form.inner.leaf", "path": "#FORM.n", "expect": "pg.f1.sub.n"},
