    {"node": "agrid.acell", "path": "#ROW", "row": "r1", "expect": "arows.r1"},
    {"node": "agrid.acell", "path": "#ROW.a.b", "row": "r1", "error": "only attribute fields"},
    {"node": "nogrid.ncell", "path": "#ROW.x", "row": "r1", "error": "rowMode must be"},
    {"node": "page.form.rec.field", "path": "#ROW.x", "row": "r1", "error": "#ROW: no ancestor with storepath"}
